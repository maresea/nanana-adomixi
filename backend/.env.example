# =============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN (ENVIRONMENT VARIABLES)
# =============================================================================

# App Config
PROJECT_NAME="Hệ thống Quản lý Công văn tích hợp AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DEBUG=True

# Database Configuration (PostgreSQL)
# Định dạng: postgresql://user:password@localhost:5432/dbname
# Mặc định dùng SQLite cho môi trường dev nhanh hoặc PostgreSQL
DATABASE_URL="sqlite:///./sql_app.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/congvan_db"

# JWT Security
SECRET_KEY="YOUR_SUPER_SECRET_KEY_REPLACE_IN_PRODUCTION_MIN_32_CHARS"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI Provider Configuration (Adapter Pattern)
# Lựa chọn: "LOCAL" (Ollama/vLLM) hoặc "CLOUD" (Gemini/OpenAI)
AI_PROVIDER="LOCAL"

# Local AI Engine (On-Premise GPU RTX 3090/4090)
LOCAL_AI_BASE_URL="http://localhost:11434"
LOCAL_AI_MODEL="llama3.1:8b"

# Cloud AI Engine (Dùng cho thử nghiệm PoC với dữ liệu giả lập - KHÔNG hardcode trong mã nguồn)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Redis & Background Queue (Optional in dev)
REDIS_URL="redis://localhost:6379/0"

# File Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=50

